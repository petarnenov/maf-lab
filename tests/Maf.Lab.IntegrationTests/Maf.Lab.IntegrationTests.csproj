<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Takes the installed provider plugins' code (Directory.Build.targets; introduce-provider-plugins). -->
    <MafProviderHost>true</MafProviderHost>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers.Qdrant" />
    <PackageReference Include="Testcontainers.Neo4j" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Maf.Lab.Domain\Maf.Lab.Domain.csproj" />
    <ProjectReference Include="..\..\src\Maf.Lab.Retrieval\Maf.Lab.Retrieval.csproj" />
    <ProjectReference Include="..\..\src\Maf.Lab.Api\Maf.Lab.Api.csproj" />
    <ProjectReference Include="..\..\src\Maf.Lab.Indexing\Maf.Lab.Indexing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\**\*.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="../../compose/keycloak/fixture.realm.json" Link="Identity/fixture.realm.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
