<Project>
  <!-- Every version is pinned here. Moving one requires a DECISIONS.md note in the same commit. -->
  <ItemGroup>
    <!-- Agent + AI abstractions -->
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.22.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0" />
    <PackageVersion Include="OllamaSharp" Version="5.4.30" />
    <!-- A2A: the protocol SDK the Agent Framework's own A2A packages are built on (see DECISIONS.md) -->
    <PackageVersion Include="A2A" Version="1.0.0-preview2" />
    <PackageVersion Include="A2A.AspNetCore" Version="1.0.0-preview2" />
    <!-- The Agent Framework's A2A client: a remote A2A agent used as an AIAgent (see DECISIONS.md for the server side) -->
    <PackageVersion Include="Microsoft.Agents.AI.A2A" Version="1.22.0-preview.260918.1" />
    <!-- AG-UI: the protocol between this system and whatever watches a run (see DECISIONS.md) -->
    <PackageVersion Include="AGUI.Abstractions" Version="1.0.0" />
    <PackageVersion Include="AGUI.Server" Version="1.0.0" />
    <!-- MCP -->
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <!-- Vector store -->
    <PackageVersion Include="Qdrant.Client" Version="1.19.0" />
    <!-- ASP.NET Core / hosting / data -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <!-- The MCP server's own small store: one table, no EF Core (see DECISIONS.md) -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.0" />
    <!-- Indexing -->
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <!-- Transitive security pins -->
    <PackageVersion Include="Microsoft.Bcl.Memory" Version="10.0.12" />
    <!-- Telemetry: the SDK, the OTLP exporter and the instrumentation for what the lab does not write itself.
         The agent and model instrumentation comes from Microsoft.Agents.AI / Microsoft.Extensions.AI above. -->
    <PackageVersion Include="OpenTelemetry" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <!-- The only EF Core instrumentation there is; it has never left beta (see DECISIONS.md). -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.19.0-beta.1" />
    <!-- Tests -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Testcontainers.Qdrant" Version="4.15.0" />
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
</Project>
