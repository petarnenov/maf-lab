<!-- The A2A code both agents need: partner identity, the card, the 1.0 wire format and the request handler.
     It depends on the domain and on the protocol packages, and on nothing that serves one agent in particular. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>A2A code both agents share: partner identity, the signed card, the 1.0 wire format, the request handler</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="A2A" />
    <PackageReference Include="A2A.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <!-- The shared task and webhook stores both agents keep their tasks in. -->
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Maf.Lab.Domain\Maf.Lab.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- A class library does not get the web SDK's implicit usings; these are the ones this code was written with. -->
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
</Project>
