<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Takes the installed provider plugins' code (Directory.Build.targets; introduce-provider-plugins). -->
    <MafProviderHost>true</MafProviderHost>
    <Description>Console app: eval datasets, runners, metrics, report</Description>
  </PropertyGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation.Reporting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Maf.Lab.Domain\Maf.Lab.Domain.csproj" />
    <ProjectReference Include="..\Maf.Lab.Retrieval\Maf.Lab.Retrieval.csproj" />
    <!-- The eval indexes its own corpora; the api no longer brings Indexing with it (extract-index-admin-plugin). -->
    <ProjectReference Include="..\Maf.Lab.Indexing\Maf.Lab.Indexing.csproj" />
    <ProjectReference Include="..\Maf.Lab.Api\Maf.Lab.Api.csproj" />
    <ProjectReference Include="..\Maf.Lab.Portfolio\Maf.Lab.Portfolio.csproj" />
    <ProjectReference Include="..\Maf.Lab.CodeSearch\Maf.Lab.CodeSearch.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Maf.Lab.Tests" />
    <InternalsVisibleTo Include="Maf.Lab.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <None Update="eval.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
