{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5080",
  "Agent": {
    "McpEndpoint": "http://localhost:5090/mcp",
    "Servers": [
      { "Domain": "portfolio", "Endpoint": "http://localhost:5091/mcp" },
      { "Domain": "codebase", "Endpoint": "http://localhost:5092/mcp", "Tools": [ "search_codebase" ] }
    ]
  },
  "Storage": {
    "ConnectionString": "Data Source=maf-lab.db"
  },
  "Auth": {
    "EnableDevIssuer": true
  },
  "A2A": {
    "RequiredScope": "a2a.billing.read"
  }
}
