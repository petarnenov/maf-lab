{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5080",
  "Agent": {
    "McpEndpoint": "http://localhost:5090/mcp",
    "Servers": [
      { "Domain": "portfolio", "Endpoint": "http://localhost:5091/mcp" },
      { "Domain": "codebase", "Endpoint": "http://localhost:5092/mcp", "Tools": [ "search_codebase" ] }
    ]
  },
  "Storage": {
    "ConnectionString": "Data Source=maf-lab.db"
  },
  "Auth": {
    "EnableDevIssuer": true
  },
  "A2A": {
    "RequiredScope": "a2a.billing.read"
  },
  "Coverage": {
    "DefaultThresholdPct": 80,
    "MainBranch": "main"
  },
  "TestAgent": {
    "Models": [
      {
        "Tag": "glm-5.3:cloud",
        "DisplayName": "GLM 5.3",
        "InputPerMTok": 0.6,
        "OutputPerMTok": 2.2,
        "BestFor": "Recommended: strong at reading a codebase and writing idiomatic tests.",
        "Default": true,
        "PriceIsEstimate": true
      },
      {
        "Tag": "kimi-k3:cloud",
        "DisplayName": "Kimi K3",
        "InputPerMTok": 0.6,
        "OutputPerMTok": 2.5,
        "BestFor": "Long files and many related types in context.",
        "Default": false,
        "PriceIsEstimate": true
      },
      {
        "Tag": "glm-5.3-flash:cloud",
        "DisplayName": "GLM 5.3 Flash",
        "InputPerMTok": 0.1,
        "OutputPerMTok": 0.4,
        "BestFor": "Cheap and fast: small files and simple branches.",
        "Default": false,
        "PriceIsEstimate": true
      },
      {
        "Tag": "deepseek-v4-pro:cloud",
        "DisplayName": "DeepSeek V4 Pro",
        "InputPerMTok": 0.55,
        "OutputPerMTok": 2.2,
        "BestFor": "Hard logic: fixing a failing build or tricky edge cases.",
        "Default": false,
        "PriceIsEstimate": true
      },
      {
        "Tag": "deepseek-v4.1-flash:cloud",
        "DisplayName": "DeepSeek V4.1 Flash",
        "InputPerMTok": 0.1,
        "OutputPerMTok": 0.4,
        "BestFor": "Cheap retries on a file that is nearly there.",
        "Default": false,
        "PriceIsEstimate": true
      }
    ]
  }
}
