<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Description>MCP server for the portfolio domain: search_portfolio_documents (own collection), household read tools</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <!-- The retrieval core (tenant-scoped search, BM25, embeddings, the Jev judge, dev JWT) is reused as a library:
         this server owns a domain, not a second way to query Qdrant. -->
    <ProjectReference Include="..\Maf.Lab.Retrieval\Maf.Lab.Retrieval.csproj" />
    <ProjectReference Include="..\Maf.Lab.Hosting\Maf.Lab.Hosting.csproj" />
    <ProjectReference Include="..\Maf.Lab.Domain\Maf.Lab.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Maf.Lab.Tests" />
    <InternalsVisibleTo Include="Maf.Lab.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="portfolio.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
