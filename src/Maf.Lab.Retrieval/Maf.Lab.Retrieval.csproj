<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Description>MCP server exposing search_documents; Qdrant access; BM25; the Jev relevance judge</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Qdrant.Client" />
    <PackageReference Include="Neo4j.Driver" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="OllamaSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Maf.Lab.Hosting\Maf.Lab.Hosting.csproj" />
    <ProjectReference Include="..\Maf.Lab.Domain\Maf.Lab.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Maf.Lab.Tests" />
    <InternalsVisibleTo Include="Maf.Lab.IntegrationTests" />
    <!-- The portfolio server reuses the search tool's result shaping, the seed paths and the bootstrap loop. -->
    <InternalsVisibleTo Include="Maf.Lab.Portfolio" />
    <InternalsVisibleTo Include="Maf.Lab.CodeSearch" />
    <!-- The graph build reads the same seed files the billing tools do. -->
    <InternalsVisibleTo Include="Maf.Lab.Indexing" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="retrieval.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
