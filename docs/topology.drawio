<?xml version="1.0" encoding="UTF-8"?>
<!-- The picture of the stack, and the only place its layout and labels are defined.
     Every node id here must equal a node id in GET /api/topology (a test asserts both directions).
     Save uncompressed: draw.io's compressed format is a base64 blob that neither a diff nor the app can read. -->
<mxfile host="maf-lab" type="device">
  <diagram id="topology" name="maf-lab topology">
    <mxGraphModel dx="1100" dy="760" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />


        <mxCell id="lb" value="lb&#10;nginx :7171 (entry point)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="290" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="web" value="web&#10;static SPA" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="120" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="api" value="api&#10;Agent Framework" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="290" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- Under lb, which is how it is reached (/compliance) and how the api consults it. It used to sit
             under the api, overlapping the chat provider, so its health line was hidden behind that box. -->
        <mxCell id="compliance" value="compliance&#10;A2A reviewer (2x)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="470" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="mcp" value="mcp-retrieval&#10;MCP server" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="290" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="qdrant" value="qdrant&#10;vector store" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="930" y="290" width="140" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ollama-embeddings" value="ollama&#10;embeddings" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="470" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="chat-provider" value="chat provider&#10;Ollama Cloud" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="470" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="redis" value="redis&#10;shared state" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="640" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="otel-collector" value="otel collector&#10;OTLP in" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="640" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="prometheus" value="prometheus&#10;metrics" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="640" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="jaeger" value="jaeger&#10;traces" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="930" y="640" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e-lb-web" value="/" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="lb" target="web">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-lb-api" value="/api, /dev" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="lb" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-lb-compliance" value="/compliance" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="lb" target="compliance">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-api-compliance" value="A2A via lb" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="api" target="compliance">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-api-mcp" value="/mcp via lb" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="api" target="mcp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-mcp-qdrant" value="gRPC" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="mcp" target="qdrant">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-mcp-embeddings" value="embed" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="mcp" target="ollama-embeddings">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-api-chat" value="chat" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="api" target="chat-provider">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-api-qdrant" value="index admin" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="api" target="qdrant">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-api-otel" value="OTLP" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="api" target="otel-collector">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-mcp-otel" value="OTLP" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="mcp" target="otel-collector">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-compliance-otel" value="OTLP" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="compliance" target="otel-collector">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-otel-prometheus" value="metrics" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="otel-collector" target="prometheus">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-otel-jaeger" value="traces" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="otel-collector" target="jaeger">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-api-prometheus" value="query" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="api" target="prometheus">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-lb-jaeger" value="/jaeger" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="lb" target="jaeger">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-api-redis" value="shared state" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="api" target="redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-mcp-redis" value="idempotency" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="mcp" target="redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-compliance-redis" value="tasks" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="compliance" target="redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
