<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Takes the installed provider plugins' code (Directory.Build.targets; introduce-provider-plugins). -->
    <MafProviderHost>true</MafProviderHost>
    <Description>MCP server over the repository itself: search_codebase, ask_codebase (own collection)</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <!-- The retrieval core (tenant-scoped search, BM25, embeddings, the Jev judge, dev JWT) is reused as a library:
         this server owns a corpus, not a second way to query Qdrant. -->
    <ProjectReference Include="..\..\..\src\Maf.Lab.Retrieval\Maf.Lab.Retrieval.csproj" />
    <ProjectReference Include="..\..\..\src\Maf.Lab.Hosting\Maf.Lab.Hosting.csproj" />
    <ProjectReference Include="..\..\..\src\Maf.Lab.Domain\Maf.Lab.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Maf.Lab.Tests" />
    <InternalsVisibleTo Include="Maf.Lab.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="codesearch.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
