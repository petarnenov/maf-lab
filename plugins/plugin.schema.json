{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maf-lab.local/plugins/plugin.schema.json",
  "title": "maf-lab plugin manifest (plugin.toml)",
  "description": "What no established format holds about a plugin (introduce-plugins decision 1): its kind, scope, environments, dependencies, domain descriptor, progress and stopping. An MCP plugin's server is described by its MCP Registry server.json, an A2A plugin by its Agent Card.",
  "type": "object",
  "required": ["schema", "name", "kind", "scope", "environments", "description", "progress", "stopping"],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "integer", "enum": [1] },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "kind": { "type": "string", "enum": ["mcp", "a2a", "app", "provider", "infra"] },
    "scope": { "type": "string", "enum": ["tenant", "installation"] },
    "environments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["dev", "qa", "stage", "prod"] }
    },
    "description": { "type": "string", "minLength": 1 },
    "depends": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } },
    "provides": { "type": "string", "minLength": 1 },
    "public": { "type": "boolean" },
    "progress": { "type": "string", "minLength": 1 },
    "stopping": { "type": "string", "minLength": 1 },
    "domain": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "tools": { "type": "array", "items": { "type": "string" } },
        "search_tool": { "type": "string" },
        "graph_tools": { "type": "array", "items": { "type": "string" } },
        "guard_context": { "type": "string" },
        "routing": { "type": "array", "items": { "type": "string" } },
        "card_types": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "agent": {
      "type": "object",
      "required": ["name", "path"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "path": { "type": "string", "pattern": "^/" }
      }
    },
    "topology": {
      "type": "object",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string" },
        "label": { "type": "string" }
      }
    }
  }
}
