<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>The jev provider plugin: TypeSafe Jev as the decision engine (IDecisionEngine) — its client, credential, retry, circuit breaker, warm-up and wire shape</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- A provider's code references the abstractions and the domain only, so every host that takes providers can hold it. -->
    <ProjectReference Include="..\..\..\src\Maf.Lab.Plugins.Abstractions\Maf.Lab.Plugins.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\src\Maf.Lab.Domain\Maf.Lab.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The implicit usings the web SDK gives the hosts this code moved from. -->
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Maf.Lab.Tests" />
    <InternalsVisibleTo Include="Maf.Lab.IntegrationTests" />
  </ItemGroup>
</Project>
