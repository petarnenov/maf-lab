<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Description>The authoring template's MCP server: one tool, tenant-scoped through the caller's bearer token. It references no core project: a plugin's server meets the core only through MCP and the token.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>
</Project>
