<Project>
  <!--
    In-process plugins are compiled in (introduce-plugins decision 5): the api, and the test projects that host it,
    reference every plugins/<name>/server/*.csproj; pure contribution libraries under plugins/<name>/lib/*.csproj go into the
    opted-in provider/indexing hosts below. The api applies only the installed ones (plugins/.installed); the
    rest are inert.

    The product image variant (decision 5e) builds with MafImageVariant=product and MafProductPlugins=|A|B| (the server
    projects of plugins whose manifest allows stage or prod, from `scripts/plugins.py product-servers`); every other
    plugin's code is left out of the build, so it is not in the image at all.
  -->
  <PropertyGroup>
    <_MafPluginHost Condition="'$(MSBuildProjectName)' == 'Maf.Lab.Api' or '$(MSBuildProjectName)' == 'Maf.Lab.Tests' or '$(MSBuildProjectName)' == 'Maf.Lab.IntegrationTests'">true</_MafPluginHost>
    <!--
      Provider plugins (introduce-provider-plugins 5t/5u) live in every process that asks a model, an embedder or the
      decision engine, so their code (plugins/<name>/lib/*.csproj, which references the abstractions and the domain only)
      goes into every project that opts in with <MafProviderHost>true</MafProviderHost> in its own csproj — not a list of
      names here, which would name a plugin's project once a host moves into a plugin. Each host registers only the
      installed ones (ProviderHost.AddInstalledProviders). This supersedes §81's "the api and the test hosts" for the
      provider kind. The same generic lib/ glob supplies pure graph builder contributions to the indexer;
      each host registers only the contribution interfaces it uses.
    -->
  </PropertyGroup>
  <ItemGroup Condition="'$(_MafPluginHost)' == 'true'">
    <_MafPluginServer Include="$(MSBuildThisFileDirectory)plugins/*/server/*.csproj" />
    <ProjectReference Include="@(_MafPluginServer)" />
  </ItemGroup>
  <ItemGroup Condition="'$(MafProviderHost)' == 'true'">
    <_MafProviderLib Include="$(MSBuildThisFileDirectory)plugins/*/lib/*.csproj" />
    <ProjectReference Include="@(_MafProviderLib)" />
  </ItemGroup>
  <!--
    A plugin's own service (plugins/<name>/service/, its own container, never compiled into the api or the product image)
    is referenced by the test projects only, so the plugin's tests can host it in process (extract-compliance-plugin;
    amends DECISIONS §81 part F, which had rejected a service/ glob for billing's eval-hosted library).
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Maf.Lab.Tests' or '$(MSBuildProjectName)' == 'Maf.Lab.IntegrationTests'">
    <_MafPluginService Include="$(MSBuildThisFileDirectory)plugins/*/service/**/*.csproj" />
    <!-- Under extern alias `service`: a service's top-level Program is global and would shadow core types (Eval's Program). -->
    <ProjectReference Include="@(_MafPluginService)" Aliases="service" />
  </ItemGroup>
  <!--
    A plugin's tests live in its folder, with no project of their own: plugins/<name>/tests/unit/ compiles into
    Maf.Lab.Tests and plugins/<name>/tests/integration/ into Maf.Lab.IntegrationTests, so they reuse the core's test
    support and leave with the folder (nothing outside it names them).
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Maf.Lab.Tests'">
    <Compile Include="$(MSBuildThisFileDirectory)plugins/*/tests/unit/**/*.cs" Link="Plugins/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Maf.Lab.IntegrationTests'">
    <Compile Include="$(MSBuildThisFileDirectory)plugins/*/tests/integration/**/*.cs" Link="Plugins/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="_MafLeaveOutNonProductPlugins" BeforeTargets="AssignProjectConfiguration"
          Condition="('$(_MafPluginHost)' == 'true' or '$(MafProviderHost)' == 'true') and '$(MafImageVariant)' == 'product'">
    <ItemGroup>
      <ProjectReference Remove="@(_MafPluginServer)" Condition="!$(MafProductPlugins.Contains('|%(_MafPluginServer.Filename)|'))" />
      <ProjectReference Remove="@(_MafProviderLib)" Condition="!$(MafProductPlugins.Contains('|%(_MafProviderLib.Filename)|'))" />
    </ItemGroup>
  </Target>
</Project>
