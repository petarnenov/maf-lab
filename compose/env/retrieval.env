# What a service that searches, embeds, chats or asks Jev reads (introduce-plugins 5.2: shared by Compose's env_file
# across the core's and the plugins' compose files, which YAML anchors cannot cross). Values are interpolated by Compose
# from the host environment; a service's own `environment:` wins over every env file.
Qdrant__Host=qdrant
Qdrant__GrpcPort=6334
Models__Provider=${MODELS_PROVIDER:-ollama}
MAF_CHAT_MODEL=${MAF_CHAT_MODEL:-ollama-cloud}
# Two Ollama instances serve the same embedding model: `ollama` embeds search queries only, `ollama-batch` embeds
# documents (indexing, migration, admin index runs), so a batch never queues in front of a search. Each runs on its own
# CPUs and every request names its thread count: a request without it reloads the runner with all 16 threads.
Models__OllamaEndpoint=http://ollama:11434
Models__OllamaNumThread=${OLLAMA_INTERACTIVE_THREADS:-4}
Models__BatchOllamaEndpoint=http://ollama-batch:11434
Models__BatchOllamaNumThread=${OLLAMA_BATCH_THREADS:-12}
Models__ChatModel=${CHAT_MODEL:-gpt-oss:120b}
# Chat runs on Ollama Cloud; the key is passed through from the host environment, never written to a file.
Models__ChatEndpoint=${CHAT_ENDPOINT:-https://ollama.com}
OLLAMA_API_KEY=${OLLAMA_API_KEY:-}
# Intent is classified by TypeSafe's Jev, and by nothing else; the retrieval server asks Jev whether a search's
# candidates are relevant. Same rule as above: passed through from the host environment, never written to a file;
# the services send it only as the bearer header to the Jev endpoint.
JEV_MAF_LAB=${JEV_MAF_LAB:-}
Models__OpenAIApiKey=${OPENAI_API_KEY:-}
Models__OpenAIEndpoint=${OPENAI_ENDPOINT:-}
