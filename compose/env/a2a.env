# The assistant's A2A surface (the a2a plugin, extract-a2a-plugin): one partner, so the agent card has
# something to authenticate. A dev secret, like the signing key.
A2A__PublicBaseUrl=${A2A_PUBLIC_BASE_URL:-http://localhost:7171}
A2A__Partners__acme-portal__Secret=${A2A_PARTNER_SECRET:-acme-portal-dev-secret}
A2A__Partners__acme-portal__Firms__0=firm-a
A2A__Partners__acme-portal__Scopes__0=a2a.billing.read

A2A__StoreKeyspace=${A2A_STORE_KEYSPACE:-assistant}
# The deployment's outbound client registration at the compliance reviewer (extract-compliance-plugin): OAuth 2.0
# client credentials are issued per authorization server — per reviewer — so they are the deployment's A2A
# configuration, given to the api whether the plugin is in use or not (a plugin's fragment never changes the api's
# environment, so switching it needs only a restart). The assistant consults as a system, never as a user.
A2A__Clients__compliance__BaseUrl=${COMPLIANCE_BASE_URL:-}
A2A__Clients__compliance__ClientId=maf-lab-assistant
A2A__Clients__compliance__ClientSecret=${COMPLIANCE_CLIENT_SECRET:-assistant-dev-secret}
