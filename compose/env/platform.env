# What every application service of the platform reads: token validation, telemetry and the shared store.
Auth__SigningKey=${AUTH_SIGNING_KEY:-maf-lab-dev-signing-key-change-me-0123456789}
# Where the signals go. Unset it and the services export nothing, which is what the tests do.
Telemetry__Endpoint=${TELEMETRY_ENDPOINT:-http://otel-collector:4317}
# The one place every replica reads. A service that needs it does not start without it.
SharedState__ConnectionString=${REDIS_CONNECTION:-redis:6379}
