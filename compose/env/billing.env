# What the billing domain, its A2A surface and its compliance reviewer read. Moves with the billing, a2a and compliance
# follow-ups (introduce-plugins 8.1).
Billing__SeedPath=/seed/billing-runs.json
Billing__AccountsSeedPath=/seed/billing-accounts.json
# One A2A partner, so the agent card has something to authenticate. A dev secret, like the signing key.
A2A__PublicBaseUrl=${A2A_PUBLIC_BASE_URL:-http://localhost:7171}
A2A__Partners__acme-portal__Secret=${A2A_PARTNER_SECRET:-acme-portal-dev-secret}
A2A__Partners__acme-portal__Firms__0=firm-a
A2A__Partners__acme-portal__Scopes__0=a2a.billing.read
# The assistant's own credentials at the compliance reviewer: it consults as a system, never as a user.
Compliance__BaseUrl=${COMPLIANCE_BASE_URL:-http://lb/compliance}
Compliance__ClientId=maf-lab-assistant
Compliance__ClientSecret=${COMPLIANCE_CLIENT_SECRET:-assistant-dev-secret}
