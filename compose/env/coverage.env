# Deployment configuration for repository work; read by the api whether the plugin is installed or not.
Coverage__RepoRoot=${MAF_LAB_REPO:-}
CoverageRunner__BaseUrl=http://coverage-runner:8080
TestAgent__BaseUrl=http://test-agent:8080
TestAgent__ClientId=maf-lab-assistant
TestAgent__ClientSecret=${TEST_AGENT_CLIENT_SECRET:-assistant-testgen-dev-secret}
GITHUB_ISSUES_TOKEN=${GITHUB_ISSUES_TOKEN:-}
