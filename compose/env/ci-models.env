# CI mode (make CI_MODE=1): the chat model and Jev both answer from the Ollama stub. Listed after a service's own env
# files, so these keys win over retrieval.env. Precedence rule: a key this file must change may not sit in a service's
# `environment:`, which beats every env file.
Models__ChatEndpoint=http://ollama:11434
Models__ChatModel=stub
# The stub also answers Jev's endpoint. A fixed placeholder, not a secret: only the stub accepts it, and nothing in CI
# can reach api.typesafe.ai.
Jev__Endpoint=http://ollama:11434
JEV_MAF_LAB=ci-stub-placeholder
